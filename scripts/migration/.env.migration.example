# Copy this file to ../../.env.migration (repo root) and fill in the value.
# The real .env.migration is gitignored — never commit credentials.
#
# Where to get this URI:
#   DO dashboard → your MongoDB cluster → Users & Databases
#   → bpni-readonly user → Connection Details → copy URI
#   Replace the database path with /blueprintnotincluded
#   Add ?authSource=admin&tls=true
#
# This user is READ-ONLY. It cannot write, delete, or run migrations.
# Safe to use for mongodump. Cannot harm prod.
#
# IMPORTANT: Treat read-only credentials as sensitive — do NOT commit real URIs.
# Store real values only in the gitignored root .env.migration or a secret manager.
# For admin/doadmin credentials, use the DO app console only — never on local machine.
PROD_READONLY_URI="mongodb+srv://bpni-readonly:<password>@<host>/blueprintnotincluded?authSource=admin&tls=true"
