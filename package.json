{
  "name": "blueprintnotincluded-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "tsc": "tsc -b",
    "typecheck": "tsc --noEmit --watch",
    "dev:full": "concurrently --names 'server,types' 'npm run dev' 'npm run typecheck'",
    "predev": "npm run build:lib",
    "dev": "ts-node-dev --respawn --transpile-only ./app/server.ts",
    "prod": "tsc -b && node ./build/server.js",
    "test": "npm run test:db-setup && TS_NODE_TRANSPILE_ONLY=true mocha",
    "test:db-setup": "./scripts/test-db-setup.sh",
    "test:only": "TS_NODE_TRANSPILE_ONLY=true mocha",
    "prebuild": "rm -rf build/",
    "build": "npm run build:backend && npm run build:lib && npm run build:frontend",
    "build:backend": "tsc -b",
    "build:lib": "tsc -b lib",
    "build:frontend": "(cd frontend && npm run build -- --output-path=../build/app/public/ && npm run build:admin -- --output-path=../build/app/public/admin/)",
    "postbuild": "./scripts/copy_assets.sh && ./scripts/copy_lib.sh && ./scripts/copy_views.sh && ./scripts/copy_public.sh",
    "serve:prod": "(cd build && node ./app/server.js)",
    "updateBasedOn": "tsc && node ./build/api/batch/update-based-on.js",
    "updatePositionCorrection": "tsc && node ./build/api/batch/update-position-correction.js",
    "updateThumbnail": "ts-node-dev --expose_gc --max_old_space_size=4096 --transpile-only ./app/api/batch/update-thumbnail.ts",
    "fixHtmlLabels": "ts-node-dev --expose_gc --max_old_space_size=4096 --transpile-only ./app/api/batch/fix-html-labels.ts",
    "derive-metadata": "TS_NODE_TRANSPILE_ONLY=true ts-node app/api/batch/derive-blueprint-metadata.ts",
    "derive-metadata:dry-run": "TS_NODE_TRANSPILE_ONLY=true ts-node app/api/batch/derive-blueprint-metadata.ts --dry-run",
    "derive-rooms": "TS_NODE_TRANSPILE_ONLY=true ts-node app/api/batch/derive-rooms.ts",
    "derive-rooms:dry-run": "TS_NODE_TRANSPILE_ONLY=true ts-node app/api/batch/derive-rooms.ts --dry-run",
    "backfill-previews": "TS_NODE_TRANSPILE_ONLY=true ts-node app/api/batch/backfill-preview-images.ts",
    "backfill-previews:dry-run": "TS_NODE_TRANSPILE_ONLY=true ts-node app/api/batch/backfill-preview-images.ts --dry-run",
    "seed:dev-blueprints": "TS_NODE_TRANSPILE_ONLY=true ts-node app/api/batch/seed-dev-blueprints.ts",
    "seed:dev-user": "TS_NODE_TRANSPILE_ONLY=true ts-node app/api/batch/seed-dev-blueprints.ts --user-only",
    "convert:2024": "TS_NODE_TRANSPILE_ONLY=true ts-node app/api/batch/convert-export-2024.ts",
    "import:2024": "TS_NODE_TRANSPILE_ONLY=true ts-node app/api/batch/convert-export-2024.ts",
    "import:2024:dry-run": "TS_NODE_TRANSPILE_ONLY=true ts-node app/api/batch/convert-export-2024.ts --dry-run",
    "import:2024:strings": "TS_NODE_TRANSPILE_ONLY=true ts-node app/api/batch/convert-export-2024.ts --strings-only",
    "migrate:status": "migrate-mongo status",
    "migrate:up": "migrate-mongo up",
    "migrate:down": "migrate-mongo down",
    "migrate:create": "migrate-mongo create",
    "migrate:workos": "node build/scripts/migrate-to-workos.js",
    "provision:workos": "node build/scripts/provision-workos-users.js",
    "format": "prettier --write \"**/*.{ts,js,json}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,js,json}\" --ignore-path .prettierignore"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@workos-inc/node": "^8.11.1",
    "adm-zip": "^0.5.10",
    "canvas": "^3.2.3",
    "crypto-js": "^4.2.0",
    "csharp-binary-stream": "^1.0.2",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.9",
    "express": "^5.1.0",
    "express-jwt": "^8.5.1",
    "helmet": "^8.3.0",
    "isbot": "^5.2.0",
    "jimp": "^1.6.0",
    "jsdom": "^26.1.0",
    "jsdom-global": "^3.0.2",
    "jsonwebtoken": "^9.0.3",
    "migrate-mongo": "^14.0.7",
    "mongoose": "^8.18.1",
    "node-mailjet": "^6.0.6",
    "nodemailer": "^6.7.2",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pixi.js-legacy": "^5.3.0",
    "request-ip": "^3.3.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.0",
    "@types/chai": "^4.3.20",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.0",
    "@types/fs-extra": "^11.0.1",
    "@types/jsdom": "^21.1.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^6.4.17",
    "@types/passport": "^1.0.1",
    "@types/passport-local": "^1.0.33",
    "@types/request-ip": "0.0.34",
    "@types/sinon": "^22.0.0",
    "@types/supertest": "^6.0.3",
    "chai": "^4.5.0",
    "concurrently": "^9.2.1",
    "fs-extra": "^11.1.1",
    "mocha": "^11.7.6",
    "prettier": "^3.6.2",
    "sinon": "^22.0.0",
    "supertest": "^7.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": "^20.19",
    "npm": "^10.0"
  },
  "volta": {
    "node": "20.19.4"
  }
}
