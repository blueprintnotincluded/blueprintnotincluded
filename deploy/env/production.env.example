# Compose-level settings for the production project. bin/env-bootstrap.sh
# copies it to /srv/bpni/production/.env (mode 600, owner deploy) with the
# passwords generated; the tokens are filled in by hand. Never commit a
# filled-in copy; bin/env-backup.sh keeps an encrypted one off the box. The
# app's own environment is app.env.

COMPOSE_PROJECT_NAME=bpni-production
# production runs whatever :prod points at; promote.yml moves that tag.
IMAGE_TAG=prod
# Starts the nightly backup sidecar. Leave unset on staging.
COMPOSE_PROFILES=backup

# Where the workflow rsyncs the repo's deploy/ directory.
DEPLOY_DIR=/srv/bpni/deploy

# Memory. The box has 4 GB (+ 2 GB swap from cloud-init) shared with staging.
APP_MEM_LIMIT=1024m
MONGO_MEM_LIMIT=1792m
MONGO_CACHE_GB=1

# MongoDB users, created on the data volume's first start (mongo/init-users.sh).
# Changing them later means changing them in mongosh too.
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=
MONGO_BACKUP_PASSWORD=

# Cloudflare Tunnel token for this project's tunnel (Zero Trust > Networks >
# Tunnels > bpni-production > Configure > the token in the docker command).
TUNNEL_TOKEN=

# Cloudflare R2 for the nightly dumps. Bucket + an API token scoped to it
# (Object Read & Write). The endpoint is https://<account id>.r2.cloudflarestorage.com
R2_BUCKET=bpni-backups
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Defaults shown; override only to tune.
# BACKUP_SCHEDULE=30 3 * * *
# BACKUP_KEEP_DAILY_DAYS=14
# BACKUP_KEEP_WEEKLY_DAYS=56
# BACKUP_KEEP_MONTHLY_DAYS=62
# BACKUP_KEEP_SEED_DAYS=30
# BACKUP_EXCLUDE_COLLECTIONS=previewimages

# Better Stack heartbeats (README "Backup monitoring"). Each is a URL the job
# requests once after it succeeded; the monitor alerts when a request stops
# arriving. Empty = no ping, which is what staging and a drill box want.
# "bpni nightly backup": period 1 day, grace 2 h; pinged by backup.sh.
BACKUP_HEARTBEAT_URL=
# "bpni weekly restore drill": period 7 days, grace 1 day; pinged by
# bin/drill-weekly.sh (Sundays 05:00 UTC from the deploy user's crontab).
DRILL_HEARTBEAT_URL=

# Better Stack log shipping (README "Log shipping"): the Vector source in the
# BNI team, whose page shows the token and the ingesting host.
# With the token set, bin/compose.sh starts the `vector` service, which ships
# this box's production AND staging container logs (staging's .env has no
# such line). Empty = no shipper, which is what a drill box and the tests
# want. The token goes in at a `read -rsp` prompt, never on a command line.
BETTERSTACK_SOURCE_TOKEN=
# The source's ingesting host: the hostname alone, no https:// and no path.
BETTERSTACK_INGEST_HOST=

# Public hostname, used by bin/deploy.sh for its post-deploy health check.
# bin/env-bootstrap.sh sets it (PRODUCTION_HOSTNAME overrides, e.g. for a drill box).
PUBLIC_HOSTNAME=blueprintnotincluded.org
