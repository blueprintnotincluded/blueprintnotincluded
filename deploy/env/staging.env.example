# Compose-level settings for the staging project. bin/env-bootstrap.sh copies
# it to /srv/bpni/staging/.env (mode 600, owner deploy) with the passwords
# generated; the tunnel token is filled in by hand. Never commit a filled-in
# copy. The app's own environment is app.env.

COMPOSE_PROJECT_NAME=bpni-staging
# staging follows :latest, which publish.yml pushes on every merge to master.
IMAGE_TAG=latest
# No backup sidecar on staging: its data is a throwaway copy of production.
# COMPOSE_PROFILES=

DEPLOY_DIR=/srv/bpni/deploy

# Smaller than production; the two projects share the 4 GB box.
APP_MEM_LIMIT=768m
MONGO_MEM_LIMIT=768m
MONGO_CACHE_GB=0.25

MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=
MONGO_BACKUP_PASSWORD=

# Token for the bpni-staging tunnel.
TUNNEL_TOKEN=

# Not used on staging (no backup profile) but harmless to fill in: the seed
# and restore-drill scripts can then read production's archives from R2.
R2_BUCKET=bpni-backups
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

PUBLIC_HOSTNAME=staging.blueprintnotincluded.org
