# The application's environment, read by the app container (compose env_file).
# bin/env-bootstrap.sh copies it to /srv/bpni/<project>/app.env (mode 600,
# owner deploy) with the hostnames set and staging's JWT_SECRET generated; the
# keys are filled in by hand, or the whole file comes back from an encrypted
# archive with bin/env-backup.sh restore. Never commit a filled-in copy.
#
# Not here, on purpose: DB_URI (compose builds it from MONGO_APP_PASSWORD in
# .env), PORT (3000 inside the container), PREVIEW_CACHE_DIR (a volume),
# AUTH_MODE (must stay unset = workos; "local" is refused in production).

# "production" enables Mailjet and refuses local auth. Staging keeps it too:
# it must behave like production, and its Mailjet keys can be the same.
ENV_NAME=production

# Public origin. Links and og:url derive from HOST; password-reset mails from
# SITE_URL. Production: the apex; staging: its own hostname (env-bootstrap.sh
# sets both). The container reads them at creation: after a change run
# `compose.sh <project> up -d app` — `start`/`restart` keep the old values.
HOST=https://blueprintnotincluded.org
SITE_URL=https://blueprintnotincluded.org

BROWSE_INCREMENT=100

# Production: the value the site already uses (password manager / env-backup
# archive) — a new one logs every user out. Staging: a fresh `openssl rand -hex
# 32` (env-bootstrap.sh does it), so a staging token can never be presented to
# production (and vice versa).
JWT_SECRET=

# Mailjet HTTP API (not SMTP — Hetzner blocks outbound 25, which does not matter here).
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_FROM_EMAIL=help@blueprintnotincluded.org

# WorkOS (Production environment, both projects). No hostname is registered
# there: the app calls the User Management API directly and builds the reset
# link from SITE_URL, so a new hostname needs nothing in the WorkOS dashboard.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_PLATFORM_ORG_ID=

# Optional paid features — leave empty to disable (see .env.sample for details).
GEMINI_API_KEY=
GEMINI_VI_TITLE_TRANSLATION_ENABLED=false
GEMINI_VI_TITLE_MONTHLY_BUDGET_MICRO_USD=0
GOOGLE_TRANSLATE_API_KEY=

# Kill switches, normally unset (= enabled).
# BLUEPRINT_FACETS_ENABLED=false
# SEARCH_V2_ENABLED=false

# Preview renderer. The worker derives its RSS cap from the container's memory
# limit (app/api/services/render-memory.ts); these override it only if needed.
# PREVIEW_WORKER_MAX_RSS_MB=384
# PREVIEW_WORKER_MAX_OLD_SPACE_MB=256
