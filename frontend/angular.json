{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "blueprintnotincluded": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "i18n": {
        "sourceLocale": "en-US",
        "locales": {
          "zh-Hans": "src/i18n/messages.zh-Hans.xlf",
          "ru": "src/i18n/messages.ru.xlf",
          "ko": "src/i18n/messages.ko.xlf"
        }
      },
      "architect": {
        "build": {
          "builder": "@ngx-env/builder:browser",
          "options": {
            "outputPath": "dist/blueprintnotincluded",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": ["src/polyfills.ts"],
            "tsConfig": "tsconfig.app.json",
            "aot": true,
            "assets": ["src/favicon_blueprint_oxygen-32x32.png", "src/assets"],
            "styles": [
              "src/styles.css",
              "node_modules/primeicons/primeicons.css",
              "node_modules/primeflex/primeflex.css",
              "node_modules/@fortawesome/fontawesome-free/css/all.min.css"
            ],
            "scripts": ["node_modules/pixi.js-legacy/dist/pixi-legacy.min.js"]
          },
          "configurations": {
            "production": {
              "localize": false,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "vendorChunk": false,
              "buildOptimizer": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "3.5mb",
                  "maximumError": "4mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb",
                  "maximumError": "10kb"
                }
              ]
            },
            "dev": {
              "localize": true,
              "optimization": false
            },
            "development": {
              "optimization": false
            },
            "zh-Hans": {
              "localize": ["zh-Hans"],
              "optimization": false
            },
            "ru": {
              "localize": ["ru"],
              "optimization": false
            },
            "ko": {
              "localize": ["ko"],
              "optimization": false
            }
          }
        },
        "serve": {
          "builder": "@ngx-env/builder:dev-server",
          "options": {
            "buildTarget": "blueprintnotincluded:build",
            "proxyConfig": "proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "blueprintnotincluded:build:production"
            },
            "zh-Hans": {
              "buildTarget": "blueprintnotincluded:build:zh-Hans"
            },
            "ru": {
              "buildTarget": "blueprintnotincluded:build:ru"
            },
            "ko": {
              "buildTarget": "blueprintnotincluded:build:ko"
            },
            "development": {
              "buildTarget": "blueprintnotincluded:build:development"
            }
          }
        },
        "extract-i18n": {
          "builder": "@ngx-env/builder:extract-i18n",
          "options": {
            "buildTarget": "blueprintnotincluded:build"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "blueprintnotincluded:build",
            "runner": "vitest",
            "tsConfig": "tsconfig.spec.json",
            "setupFiles": ["src/test-setup.ts"],
            "include": ["src/**/*.spec.ts"],
            "codeCoverageReporters": [
              "text-summary",
              "lcov",
              "html",
              "cobertura"
            ]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["src/**/*.ts", "src/**/*.html"]
          }
        }
      }
    },
    "blueprintnotincluded-admin": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src-admin",
      "prefix": "admin",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/admin",
            "index": "src-admin/index.html",
            "main": "src-admin/main.ts",
            "polyfills": ["src/polyfills.ts"],
            "tsConfig": "tsconfig.admin.json",
            "aot": true,
            "assets": [
              { "glob": "**/*", "input": "src/assets", "output": "/assets" }
            ],
            "styles": [
              "src/styles.css",
              "node_modules/primeicons/primeicons.css",
              "node_modules/primeflex/primeflex.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src-admin/environments/environment.ts",
                  "with": "src-admin/environments/environment.prod.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "vendorChunk": false,
              "buildOptimizer": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1mb",
                  "maximumError": "2mb"
                }
              ]
            },
            "development": {
              "optimization": false,
              "baseHref": "/"
            }
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "buildTarget": "blueprintnotincluded-admin:build:development",
            "proxyConfig": "proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "blueprintnotincluded-admin:build:production"
            },
            "development": {
              "buildTarget": "blueprintnotincluded-admin:build:development"
            }
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["src-admin/**/*.ts", "src-admin/**/*.html"]
          }
        }
      }
    }
  },
  "cli": {
    "schematicCollections": ["@angular-eslint/schematics"]
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
