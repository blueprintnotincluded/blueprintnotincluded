{
  "name": "blueprintnotincluded",
  "version": "0.0.0",
  "scripts": {
    "prepare": "cd ../ && husky ./frontend/.husky",
    "ng": "ng",
    "build:database-zip": "node scripts/build-database-zip.js",
    "prestart": "node scripts/build-database-zip.js",
    "prebuild": "node scripts/build-database-zip.js",
    "start": "ng serve blueprintnotincluded",
    "start:zh-Hans": "ng serve blueprintnotincluded --configuration=zh-Hans",
    "start:ru": "ng serve blueprintnotincluded --configuration=ru",
    "start:ko": "ng serve blueprintnotincluded --configuration=ko",
    "build": "ng build blueprintnotincluded --configuration=production",
    "build:admin": "ng build blueprintnotincluded-admin --configuration=production",
    "build:admin:dev": "ng build blueprintnotincluded-admin --configuration=development",
    "start:admin": "ng serve blueprintnotincluded-admin --port=4201",
    "build:dev": "ng build blueprintnotincluded --configuration=dev",
    "test": "ng test --no-watch",
    "test:coverage": "ng test --no-watch --code-coverage",
    "lint": "ng lint",
    "compodoc": "npx compodoc -p tsconfig.app.json",
    "extract-i18n": "ng extract-i18n blueprintnotincluded --output-path src/i18n && xliffmerge --profile xliffmerge.json"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.18",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.18",
    "@angular/compiler": "^20.3.18",
    "@angular/core": "^20.3.18",
    "@angular/forms": "^20.3.18",
    "@angular/localize": "^20.3.18",
    "@angular/platform-browser": "^20.3.18",
    "@angular/platform-browser-dynamic": "^20.3.18",
    "@angular/router": "^20.3.18",
    "@fortawesome/fontawesome-free": "^5.14.0",
    "@primeuix/themes": "^2.0.3",
    "@sentry/angular": "^9.47.1",
    "csharp-binary-stream": "^1.0.2",
    "gettext-parser": "^4.2.0",
    "js-yaml": "^4.1.1",
    "jszip": "^3.5.0",
    "ngx-google-analytics": "^14.0.1",
    "pixi.js-legacy": "^5.3.3",
    "primeflex": "^3.1.2",
    "primeicons": "^5.0.0",
    "primeng": "^20.4.0",
    "rxjs": "^7.4.0",
    "sanitize-filename": "^1.6.3",
    "util": "^0.12.4",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.22",
    "@angular/cli": "^20.3.22",
    "@angular/compiler-cli": "^20.3.18",
    "@angular/language-service": "^20.3.18",
    "@ngx-env/builder": "^20.1.1",
    "@types/gettext-parser": "^4.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.37",
    "@vitest/coverage-v8": "^3.2.6",
    "angular-eslint": "^20.7.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "ng-lint-staged": "^12.0.4",
    "ngx-i18nsupport": "^0.17.1",
    "prettier": "^3.9.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^3.2.6"
  },
  "resolutions": {
    "serialize-javascript": "^2.1.1"
  },
  "engines": {
    "node": "^20.19",
    "npm": "^10.0"
  },
  "volta": {
    "node": "20.19.4"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.59.0"
  }
}
