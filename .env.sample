ENV_NAME="development"
HOST="http://localhost:4200"
BROWSE_INCREMENT="10"
DB_URI="mongodb://localhost:27017/blueprintnotincluded"
JWT_SECRET="anylongstringhere"
SMTP_HOST="localhost"
SMTP_PORT="1025"

# WorkOS Configuration (for authentication)
# Get these from https://dashboard.workos.com
WORKOS_API_KEY="sk_test_your_key_here"
WORKOS_CLIENT_ID="client_your_client_id_here"
# ID of the internal "Blueprint Platform" org used for admin role checks
WORKOS_PLATFORM_ORG_ID="org_your_org_id_here"
SITE_URL="http://localhost:3000"

# Gemini avatar generation (agent/AVATARS.md)
# Create a key at https://aistudio.google.com/apikey — image models need a
# billing-enabled project (no free tier). Leave unset to disable the feature.
GEMINI_API_KEY=""
# Optional overrides (defaults shown)
# AVATAR_IMAGE_MODEL="gemini-3.1-flash-image"
# AVATAR_CLASSIFY_MODEL="gemini-3.5-flash"
# AVATAR_POOL_LOW_WATER="5"
# AVATAR_POOL_REFILL="5"
